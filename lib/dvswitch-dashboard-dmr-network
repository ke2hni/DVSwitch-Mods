#!/bin/bash
set -euo pipefail
LIVE=/opt/MMDVM_Bridge/MMDVM_Bridge.ini
PRESETS=/etc/dvswitch-mods/dmr-presets
BACKUPS=/var/backups/dvswitch-mods/dmr-network
STATE=/var/lib/mmdvm/dvswitch-mods-dmr-state.json
case "${1-}" in bm) preset="$PRESETS/MMDVM_Bridge.BM.ini"; expected='brandmeister' ;; tgif) preset="$PRESETS/MMDVM_Bridge.TGIF.ini"; expected='tgif.network' ;; status) sed -n '/^\[DMR Network\]/,/^\[/s/^Address=//p' "$LIVE" | head -n1; exit ;; *) exit 64 ;; esac
[[ -r "$preset" && -r "$LIVE" ]] || exit 1
[[ "$(stat -c %a "$PRESETS")" == 700 && "$(stat -c %a "$preset")" == 600 ]] || exit 1
address(){ sed -n '/^\[DMR Network\]/,/^\[/s/^Address=//p' "$1" | head -n1; }
update_state(){
    [[ -e "$STATE" ]] || return 0
    STATE_FILE="$STATE" NETWORK="$1" python3 - <<'PY'
import json, os, stat, tempfile
from pathlib import Path
path = Path(os.environ['STATE_FILE'])
network = os.environ['NETWORK'].upper()
with path.open(encoding='utf-8') as source:
    state = json.load(source)
if not isinstance(state, dict):
    raise ValueError('DMR state is not a JSON object')
state['current_network'] = network
mode = stat.S_IMODE(path.stat().st_mode)
fd, name = tempfile.mkstemp(prefix=f'.{path.name}.', dir=str(path.parent), text=True)
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as target:
        json.dump(state, target, indent=4)
        target.write('\n')
    os.chown(name, path.stat().st_uid, path.stat().st_gid)
    os.chmod(name, mode)
    os.replace(name, path)
except Exception:
    try: os.unlink(name)
    except FileNotFoundError: pass
    raise
PY
}
addr=$(address "$preset"); [[ "$addr" == *"$expected"* ]] || exit 1
mkdir -p "$BACKUPS"; stamp=$(date +%Y%m%d-%H%M%S); backup="$BACKUPS/$stamp"; mkdir "$backup"; cp -a "$LIVE" "$backup/MMDVM_Bridge.ini"
tmp="$LIVE.dmr-switch.$$"; live_mode=$(stat -c %a "$LIVE"); live_uid=$(stat -c %u "$LIVE"); live_gid=$(stat -c %g "$LIVE")
trap 'status=$?; rm -f "$tmp"; if [[ "$status" -ne 0 ]]; then install -o "$live_uid" -g "$live_gid" -m "$live_mode" "$backup/MMDVM_Bridge.ini" "$LIVE"; systemctl restart analog_bridge.service mmdvm_bridge.service >/dev/null 2>&1 || true; fi' EXIT
install -o "$live_uid" -g "$live_gid" -m "$live_mode" "$preset" "$tmp"; mv -f "$tmp" "$LIVE"; systemctl restart analog_bridge.service mmdvm_bridge.service; sleep 3; /opt/MMDVM_Bridge/dvswitch.sh mode dmr; [[ "$(address "$LIVE")" == "$addr" ]]; systemctl is-active --quiet analog_bridge.service; systemctl is-active --quiet mmdvm_bridge.service; update_state "$1"; trap - EXIT; echo "DMR network switched to $1"
